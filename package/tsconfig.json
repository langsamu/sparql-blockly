{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2024",
    "types": [ "node" ],
    "strict": false,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [ "src", "test", "support" ]
}
